        <mxCell id="uc-note" value="&lt;b&gt;Scope notes&lt;/b&gt;&lt;br&gt;• Successful sign-up redirects to &lt;code&gt;/login&lt;/code&gt;; it does not log the user in automatically.&lt;br&gt;• All POST routes require a valid CSRF token; a successful login resets the anonymous session before setting &lt;code&gt;user_id&lt;/code&gt;.&lt;br&gt;• No password-reset, email-verification, or role-management use case is implemented." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#d69e36;fontColor=#704d12;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="45" y="1030" width="230" height="205" as="geometry" />
        </mxCell>
        <mxCell id="uc-legend" value="&lt;b&gt;Relationship legend&lt;/b&gt;&lt;br&gt;Solid line: actor association&lt;br&gt;Dashed arrow «include»: mandatory included behavior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#334155;fontSize=11;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1225" width="370" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="class-task1" name="Class Diagram">
    <mxGraphModel dx="1900" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cl-title" value="&lt;b&gt;Class Diagram — Task1 Authentication Architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size:12px&quot;&gt;Source-aligned UML: concrete classes, Python modules, session payload, and SQLite table&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#18324b;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="160" y="25" width="1020" height="65" as="geometry" />
        </mxCell>
        <mxCell id="class-app" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;module&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;app.py — Application&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Factory / helpers&lt;/b&gt;&lt;br&gt;+ create_app(test_config=None): Flask&lt;br&gt;+ get_csrf_token(): str&lt;br&gt;+ current_user(): UserRow | None&lt;br&gt;+ _reject_bad_csrf(): None&lt;br&gt;+ _security_headers(response)&lt;hr&gt;&lt;b&gt;Route handlers (nested in create_app)&lt;/b&gt;&lt;br&gt;+ index() — GET /&lt;br&gt;+ login() — GET, POST /login&lt;br&gt;+ signup() — GET, POST /signup&lt;br&gt;+ home() — GET /home&lt;br&gt;+ logout() — POST /logout&lt;br&gt;+ render_auth(...), redirect_home_if_logged_in()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f7fc;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="500" height="525" as="geometry" />
        </mxCell>
        <mxCell id="class-auth" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;module&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;auth_service.py — AuthService&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Constants&lt;/b&gt;&lt;br&gt;USERNAME_PATTERN = [A-Za-z0-9_]{3,20}&lt;br&gt;MIN_PASSWORD_LENGTH = 8&lt;br&gt;MAX_PASSWORD_LENGTH = 128&lt;br&gt;DUMMY_HASH: str&lt;hr&gt;&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;+ signup(username, password): Result&lt;br&gt;+ login(username, password): Result&lt;hr&gt;&lt;font color=&quot;#475569&quot;&gt;Uses Werkzeug password hashing/checking; performs no Flask or SQL operations.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f7fc;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="125" width="470" height="390" as="geometry" />
        </mxCell>
        <mxCell id="class-result" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;dataclass, frozen&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Result&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Attributes&lt;/b&gt;&lt;br&gt;+ ok: bool&lt;br&gt;+ error: str | None = None&lt;br&gt;+ user_id: int | None = None&lt;hr&gt;&lt;font color=&quot;#475569&quot;&gt;Returned by signup() and login().&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1320" y="125" width="390" height="240" as="geometry" />
        </mxCell>
        <mxCell id="class-session" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;Flask session payload&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Session&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Keys used by app.py&lt;/b&gt;&lt;br&gt;+ user_id: int | None&lt;br&gt;+ csrf: str | None&lt;hr&gt;&lt;font color=&quot;#475569&quot;&gt;Signed session cookie managed by Flask. On successful login, the old session is cleared before user_id is set; logout clears the session.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1320" y="420" width="390" height="260" as="geometry" />
        </mxCell>
        <mxCell id="class-config" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;class&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;config.py — Config&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Class attributes&lt;/b&gt;&lt;br&gt;+ DATABASE: Path&lt;br&gt;+ SECRET_KEY: str&lt;br&gt;+ SESSION_COOKIE_HTTPONLY: bool&lt;br&gt;+ SESSION_COOKIE_SAMESITE: str&lt;br&gt;+ SESSION_COOKIE_SECURE: bool&lt;br&gt;+ MAX_CONTENT_LENGTH: int&lt;hr&gt;&lt;b&gt;Module function&lt;/b&gt;&lt;br&gt;+ load_secret_key(instance_dir): str" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="790" width="500" height="360" as="geometry" />
        </mxCell>
        <mxCell id="class-database" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;module&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;database.py — Database&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;+ get_db(): sqlite3.Connection&lt;br&gt;+ close_db(e=None): None&lt;br&gt;+ init_db(): None&lt;br&gt;+ init_app(app: Flask): None&lt;hr&gt;&lt;font color=&quot;#475569&quot;&gt;Owns request-scoped SQLite connection lifecycle and applies schema.sql.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f7fc;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="730" width="470" height="340" as="geometry" />
        </mxCell>
        <mxCell id="class-repository" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;module&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;repository.py — Repository&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;+ create_user(username, password_hash): int&lt;br&gt;+ get_user_by_username(username): Row | None&lt;br&gt;+ get_user_by_id(user_id): Row | None&lt;br&gt;+ count_users(): int&lt;hr&gt;&lt;font color=&quot;#475569&quot;&gt;Only module that writes SQL. Uses parameterized statements and commits/rolls back inserts.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f7fc;strokeColor=#3b6385;strokeWidth=2;fontColor=#1e293b;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
