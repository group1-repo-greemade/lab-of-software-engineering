ll id="1" parent="0"/><mxCell id="cl-t" value="CLASS DIAGRAM — Domain and Application Responsibilities" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#102a43;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="20" width="1040" height="55" as="geometry"/></mxCell><mxCell id="cl-user" value="&amp;lt;&amp;lt;database entity&amp;gt;&amp;gt; User row&lt;br&gt;--------------------&lt;br&gt;+ id: int&lt;br&gt;+ username: str&lt;br&gt;+ password_hash: str&lt;br&gt;+ created_at: datetime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="320" height="190" as="geometry"/></mxCell><mxCell id="cl-result" value="&amp;lt;&amp;lt;dataclass&amp;gt;&amp;gt; Result&lt;br&gt;--------------------&lt;br&gt;+ ok: bool&lt;br&gt;+ error: str | None&lt;br&gt;+ user_id: int | None&lt;br&gt;--------------------&lt;br&gt;immutable outcome" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="490" y="145" width="330" height="210" as="geometry"/></mxCell><mxCell id="cl-dupe" value="&amp;lt;&amp;lt;exception&amp;gt;&amp;gt; DuplicateUsernameError&lt;br&gt;--------------------&lt;br&gt;Raised on unique username conflict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="950" y="165" width="370" height="135" as="geometry"/></mxCell><mxCell id="cl-config" value="Config&lt;br&gt;--------------------&lt;br&gt;+ DATABASE: Path&lt;br&gt;+ SECRET_KEY: str&lt;br&gt;+ SESSION_COOKIE_HTTPONLY: bool&lt;br&gt;+ SESSION_COOKIE_SAMESITE: str&lt;br&gt;+ MAX_CONTENT_LENGTH: int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="55" y="490" width="320" height="230" as="geometry"/></mxCell><mxCell id="cl-auth" value="auth_service module&lt;br&gt;--------------------&lt;br&gt;+ signup(username, password): Result&lt;br&gt;+ login(username, password): Result&lt;br&gt;+ username/password validation&lt;br&gt;+ generate / check password hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="490" y="455" width="370" height="230" as="geometry"/></mxCell><mxCell id="cl-app" value="Flask application&lt;br&gt;--------------------&lt;br&gt;+ create_app(test_config)&lt;br&gt;+ index() / login() / signup()&lt;br&gt;+ home() / logout()&lt;br&gt;+ current_user()&lt;br&gt;+ CSRF and security headers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="1000" y="455" width="340" height="230" as="geometry"/></mxCell><mxCell id="cl-repo" value="repository module&lt;br&gt;--------------------&lt;br&gt;+ create_user(): int&lt;br&gt;+ get_user_by_username(): Row?&lt;br&gt;+ get_user_by_id(): Row?&lt;br&gt;+ count_users(): int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3976a8;strokeWidth=2;fontColor=#17324d;fontSize=13;align=left;verticalAlign=top;spacing=8;separatorColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="55" y="800" width="340" height="190" as="geometry"/></mxCell><mxCell id="cl-db" value="database module&lt;br&gt;--------------------&lt;br&gt;+ get_db(): Con