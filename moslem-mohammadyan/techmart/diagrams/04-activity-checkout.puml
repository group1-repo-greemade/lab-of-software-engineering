@startuml
skinparam shadowing false
start
:مشتری محصولات را انتخاب می‌کند;
:محصولات به سبد خرید اضافه می‌شوند;
if (کاربر وارد حساب شده است؟) then (بله)
else (خیر)
  :نمایش فرم ورود یا ثبت‌نام;
  if (اطلاعات ورود معتبر است؟) then (بله)
  else (خیر)
    :نمایش پیام خطا;
    stop
  endif
endif
:نمایش سبد خرید;
:ورود آدرس و شماره همراه;
:انتخاب روش پرداخت;
if (اطلاعات سفارش معتبر است؟) then (بله)
else (خیر)
  :نمایش خطای اعتبارسنجی;
  stop
endif
:بررسی موجودی محصولات;
if (موجودی کافی است؟) then (بله)
  :محاسبه مبلغ کل;
  :ایجاد سفارش;
  :کاهش موجودی محصولات;
  :پاک‌کردن سبد خرید;
  :نمایش کد سفارش;
  stop
else (خیر)
  :اعلام کمبود موجودی;
  stop
endif
@enduml
