@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "مشتری" as Customer
actor "مدیر فروشگاه" as Admin

rectangle "سامانه فروشگاه اینترنتی TechMart" {
  usecase "مشاهده محصولات" as UC1
  usecase "جست‌وجو و فیلتر محصولات" as UC2
  usecase "ثبت‌نام" as UC3
  usecase "ورود و خروج" as UC4
  usecase "مدیریت سبد خرید" as UC5
  usecase "ثبت سفارش" as UC6
  usecase "مشاهده سفارش‌های من" as UC7
  usecase "مشاهده وضعیت سفارش" as UC8
  usecase "مدیریت محصولات" as UC9
  usecase "مشاهده سفارش‌های همه مشتریان" as UC10
  usecase "تغییر وضعیت سفارش" as UC11
  usecase "اعتبارسنجی موجودی" as UC12
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5
Customer --> UC6
Customer --> UC7
Customer --> UC8
Admin --> UC4
Admin --> UC9
Admin --> UC10
Admin --> UC11
UC6 .> UC12 : <<include>>
UC6 .> UC5 : <<include>>
@enduml
